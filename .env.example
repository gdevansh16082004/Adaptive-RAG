# ---- Model providers -----------------------------------------------------
# Chat LLM: groq | openai | huggingface | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b            # alt: openai/gpt-oss-20b (faster), qwen/qwen3.6-27b
STRUCTURED_OUTPUT_METHOD=json_mode                # gpt-oss follows "Respond as JSON" literally; tool-call mode breaks on Groq
OPENAI_MODEL=gpt-4o-mini                       # only used if LLM_PROVIDER=openai

# Embeddings: huggingface_local | huggingface_api | groq_openai_compat | openai
EMBEDDINGS_PROVIDER=huggingface_local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384-dim; local, offline
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here

# Leave empty for library default; set "json_mode" if a model chokes on
# tool-based structured output
# STRUCTURED_OUTPUT_METHOD=json_mode  (moved to top, next to GROQ_MODEL)

# NOTE: never mix embedding providers once documents are ingested — the
# Qdrant collection dimension is fixed by whichever provider ingested first.

# ---- Web search ----------------------------------------------------------
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ---- Qdrant Configuration ------------------------------------------------
# Local Docker: http://localhost:6333
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DOCS_COLLECTION=documents

# ---- MongoDB Configuration -----------------------------------------------
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=adaptive_rag

# ---- Retrieval tuning ----------------------------------------------------
RETRIEVER_K=4
MAX_DOCS_PER_QUERY=20
